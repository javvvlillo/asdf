# Postgres (Neon o Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Flow.cl - sandbox por defecto. En producción cambiar las 3 variables.
FLOW_API_URL="https://sandbox.flow.cl/api"
FLOW_API_KEY=""
FLOW_SECRET_KEY=""

# Resend
RESEND_API_KEY=""
EMAIL_FROM="Nuestra Boda <hola@tudominio.cl>"
EMAIL_NOTIFY_TO=""

# Admin (clave simple, sin sistema de auth)
ADMIN_SECRET=""

# URL pública del sitio, usada para armar urlConfirmation/urlReturn de Flow
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
