# Postgres (Neon o Supabase). DATABASE_URL_UNPOOLED es la conexión directa
# (sin pgbouncer) que usa `prisma migrate deploy` - en Neon/Vercel Postgres
# suele venir como *_DATABASE_URL_UNPOOLED o *_POSTGRES_URL_NON_POOLING.
# En desarrollo local ambas pueden apuntar a la misma base.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# Mercado Pago - el modo (pruebas vs producción) lo determina el prefijo
# del access token (TEST-... vs APP_USR-...), no hay host separado.
MP_ACCESS_TOKEN=""
# Secreto de firma del webhook (panel de Mercado Pago > Tus integraciones > Webhooks)
MP_WEBHOOK_SECRET=""

# Resend
RESEND_API_KEY=""
EMAIL_FROM="Nuestra Boda <hola@tudominio.cl>"
EMAIL_NOTIFY_TO=""

# Admin (clave simple, sin sistema de auth)
ADMIN_SECRET=""

# Vercel Cron: protege /api/cron/* (Vercel manda Authorization: Bearer $CRON_SECRET)
CRON_SECRET=""

# URL pública del sitio, usada para armar notification_url/back_urls de Mercado Pago
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
