generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión "pooled" para la app en runtime (serverless = muchas conexiones cortas).
  url       = env("DATABASE_URL")
  // Conexión directa para prisma migrate deploy - las migraciones corren DDL,
  // que no siempre funciona bien a través del connection pooler de Neon.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Registry {
  id             String   @id @default(cuid())
  slug           String   @unique
  coupleNames    String
  weddingDate    DateTime
  welcomeMessage String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items Item[]
}

model Item {
  id          String   @id @default(cuid())
  registryId  String
  registry    Registry @relation(fields: [registryId], references: [id])
  name        String
  description String?
  imageUrl    String?
  price       Int // CLP, pesos enteros - sin decimales
  order       Int      @default(0)
  // Disponible = stock > 0, agotado = stock <= 0. Nunca baja al iniciar un
  // pago, solo cuando Mercado Pago confirma uno aprobado - ver
  // applyPaymentStatus. Puede quedar en negativo si dos invitados pagan
  // casi al mismo tiempo con poco stock; eso dispara una alerta manual.
  stock       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contributions Contribution[]

  @@index([registryId])
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Contribution {
  id          String             @id @default(cuid())
  itemId      String
  item        Item               @relation(fields: [itemId], references: [id])
  guestName   String
  guestEmail  String
  message     String?
  amount      Int
  status      ContributionStatus @default(PENDING)
  mpPaymentId String?
  externalReference String       @unique
  createdAt   DateTime           @default(now())
  confirmedAt DateTime?

  @@index([itemId, status])
  @@index([mpPaymentId])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  mpPaymentId String  @unique
  payloadRaw String   @db.Text
  processed  Boolean  @default(false)
  attempts   Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())
}
